{
  "name": "cap-sup",
  "private": true,
  "version": "1.0.0",
  "description": "Cap Sup — aide à la décision pour la poursuite d'études après un Bac+2 / Bac+3 (et en option après le bac), à partir des données ouvertes officielles.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "data:fetch": "node scripts/fetch-sources.mjs",
    "data:refresh": "node scripts/fetch-sources.mjs --refresh && node scripts/build-data.mjs",
    "data:build": "node scripts/build-data.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/leaflet": "1.9.22",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
